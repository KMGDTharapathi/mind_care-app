<?xml version="1.0" encoding="utf-8"?>
<!-- 315deg = top-left to bottom-right, matching LinearGradient(
    begin: Alignment.topLeft, end: Alignment.bottomRight) in AppColors. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/launch_gradient_start"
        android:endColor="@color/launch_gradient_end"
        android:type="linear" />
</shape>
